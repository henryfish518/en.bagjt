---
/**
 * 首页 /{lang}/
 * -----------------------------------------------------------------------------
 * 模块：Hero → 优势 → 产品 → 应用领域 → 定制能力 → 质检 + 标准参数
 *       → 合作流程 → CTA
 * RTL：整页依赖 Tailwind 逻辑属性，阿拉伯语下自动镜像。
 */
import MainLayout from '@/layouts/MainLayout.astro';
import Hero from '@/components/Hero.astro';
import ProductCard from '@/components/ProductCard.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import CtaBand from '@/components/CtaBand.astro';
import { useTranslations, type Locale, getLocalizedPath } from '@/i18n';
import { getEntry } from 'astro:content';

export function getStaticPaths() {
  return [{ params: { lang: 'ar' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params as { lang: Locale };
const locale = lang;
const isAr = locale === 'ar';
const t = useTranslations(locale);

const h = t.home;

/** 产品数据（content collection：src/content/products/{lang}.json） */
const productsData = (await getEntry('products', locale))?.data;

/** 首页展示前 6 个产品 */
const featured = productsData?.items.slice(0, 6) ?? [];

/** 页面内的零星双语短句（数量少，直接内联，避免污染语言包结构） */
const L = {
  exportLabel: isAr ? 'التصدير إلى الشرق الأوسط' : 'Export to the Middle East',
  exportRegions: 'SA · AE · EG · IQ',
  placeholderLabel: isAr ? 'مساحة للصورة' : 'Image placeholder',
  tipTitle: isAr ? 'نصيحة:' : 'Tip:',
  tipText: isAr
    ? 'أرسل لنا المقاس وسعة التحميل ونوع المادة — وسنقترح التصميم الأمثل ووزن النسيج المناسب.'
    : 'Send us the size, load capacity and your product — we will recommend the optimal construction and fabric weight.',
};
---

<MainLayout
  locale={locale}
  slug=""
  title={h.meta.title}
  description={h.meta.description}
  keywords={h.meta.keywords}
>
  <!-- ==================== Hero ==================== -->
  <Hero
    locale={locale}
    badge={h.hero.badge}
    title={h.hero.title}
    titleAccent={h.hero.titleAccent}
    subtitle={h.hero.subtitle}
    primaryCta={h.hero.primaryCta}
    secondaryCta={h.hero.secondaryCta}
    stats={h.hero.stats}
    imageAlt={h.hero.imageAlt}
    exportLabel={L.exportLabel}
    exportRegions={L.exportRegions}
    placeholderLabel={L.placeholderLabel}
  />

  <!-- ==================== 优势 ==================== -->
  <section class="bg-white py-16 lg:py-20">
    <div class="container-x">
      <SectionHeader eyebrow={h.features.eyebrow} title={h.features.title} subtitle={h.features.subtitle} align="center" />

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {h.features.items.map((item, i) => (
          <div class="card p-6 transition-shadow hover:shadow-cardHover">
            <span class="flex h-11 w-11 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
              {i === 0 && (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20h20M4 20V8l8-5 8 5v12M9 20v-6h6v6"/></svg>
              )}
              {i === 1 && (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>
              )}
              {i === 2 && (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg>
              )}
              {i === 3 && (
                <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 3h15v13H1zM16 8h4l3 3v5h-7"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              )}
            </span>
            <h3 class="mt-4 text-base font-bold text-brand-700">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== 产品 ==================== -->
  <section class="border-y border-slate-100 bg-slate-50 py-16 lg:py-20">
    <div class="container-x">
      <div class="flex flex-col items-start justify-between gap-6 lg:flex-row lg:items-end">
        <SectionHeader eyebrow={h.products.eyebrow} title={h.products.title} subtitle={h.products.subtitle} />
        <a href={getLocalizedPath(locale, 'products')} class="btn-outline shrink-0">
          {h.products.cta}
          <svg class="h-4 w-4 flip-rtl" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((p) => (
          <ProductCard
            locale={locale}
            id={p.id}
            name={p.name}
            short={p.short}
            applications={p.applications}
            specs={p.specs}
            imageAlt={p.imageAlt}
            customizableLabel={t.products.list.customizableLabel}
            learnMoreLabel={t.common.learnMore}
            specsLabel={t.products.card.specsLabel}
            applicationsLabel={t.products.card.applicationsLabel}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== 应用领域 ==================== -->
  <section class="bg-white py-16 lg:py-20">
    <div class="container-x">
      <SectionHeader eyebrow={h.applications.eyebrow} title={h.applications.title} subtitle={h.applications.subtitle} align="center" />

      <div class="mt-12 grid gap-px overflow-hidden rounded-xl border border-slate-200 bg-slate-200 sm:grid-cols-2 lg:grid-cols-3">
        {h.applications.items.map((a) => (
          <div class="group bg-white p-6 transition-colors hover:bg-brand-50">
            <div class="flex items-center gap-3">
              <span class="h-8 w-1 rounded-full bg-accent-500 transition-all group-hover:h-10"></span>
              <h3 class="text-base font-bold text-brand-700">{a.title}</h3>
            </div>
            <p class="mt-3 ps-4 text-sm leading-relaxed text-slate-600">{a.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== 定制能力 ==================== -->
  <section class="relative overflow-hidden bg-brand-800 py-16 text-white lg:py-20">
    <div class="absolute inset-0 bg-grid opacity-50" aria-hidden="true"></div>
    <div class="container-x relative">
      <SectionHeader eyebrow={h.customization.eyebrow} title={h.customization.title} subtitle={h.customization.subtitle} align="center" onDark />

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {h.customization.items.map((c) => (
          <div class="rounded-xl border border-white/10 bg-white/5 p-5 backdrop-blur-sm transition-colors hover:border-accent-400/50 hover:bg-white/10">
            <h3 class="text-sm font-bold uppercase tracking-wide text-accent-400">{c.label}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-brand-100">{c.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== 质检 + 标准参数 ==================== -->
  <section class="bg-white py-16 lg:py-20">
    <div class="container-x grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionHeader eyebrow={h.quality.eyebrow} title={h.quality.title} subtitle={h.quality.subtitle} />

        <ol class="mt-8 space-y-5">
          {h.quality.items.map((q, i) => (
            <li class="flex gap-4">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-accent-50 text-xs font-bold text-accent-600">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="text-sm font-bold text-brand-700">{q.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-slate-600">{q.desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <!-- 标准参数表 -->
      <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-8">
        <h3 class="text-lg font-bold text-brand-700">{t.products.specTitle}</h3>
        <div class="mt-5 rounded-xl border border-slate-200 bg-white px-5 py-2">
          {productsData.specs.map((s) => (
            <div class="spec-row">
              <span class="spec-key">{s.key}</span>
              <span class="spec-val" dir="auto">{s.value}</span>
            </div>
          ))}
        </div>

        <div class="mt-6 rounded-lg border border-accent-200 bg-accent-50 p-4">
          <p dir="auto" class="text-xs leading-relaxed text-accent-800">
            <span class="font-bold">{L.tipTitle}</span>
            {' '}{L.tipText}
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== 合作流程 ==================== -->
  <section class="border-t border-slate-100 bg-slate-50 py-16 lg:py-20">
    <div class="container-x">
      <SectionHeader eyebrow={h.process.eyebrow} title={h.process.title} align="center" />

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {h.process.steps.map((s, i) => (
          <div class="relative">
            <div class="card h-full p-6">
              <span class="text-3xl font-extrabold tabular-nums text-brand-100">{s.no}</span>
              <h3 class="mt-3 text-base font-bold text-brand-700">{s.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-600">{s.desc}</p>
            </div>
            {i < h.process.steps.length - 1 && (
              <svg class="absolute -end-3 top-1/2 hidden h-6 w-6 -translate-y-1/2 text-brand-200 flip-rtl lg:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M13 6l6 6-6 6"/>
              </svg>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== CTA ==================== -->
  <CtaBand
    locale={locale}
    title={h.cta.title}
    subtitle={h.cta.subtitle}
    primary={h.cta.primary}
    secondary={t.common.whatsapp}
    tertiary={t.common.email}
    primaryAction="contact"
    secondaryAction="whatsapp"
    tertiaryAction="email"
  />
</MainLayout>
