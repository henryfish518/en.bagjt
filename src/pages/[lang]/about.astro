---
/**
 * 关于我们 /{lang}/about/
 * -----------------------------------------------------------------------------
 * 模块：页头 → 公司简介 → 数据 → 优势 → 生产能力 → 资质认证 → 服务行业
 *       → 质量方针 → 合作客户 → 服务市场 → CTA
 */
import MainLayout from '@/layouts/MainLayout.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import CtaBand from '@/components/CtaBand.astro';
import { useTranslations, type Locale, getLocalizedPath } from '@/i18n';

export function getStaticPaths() {
  return [{ params: { lang: 'ar' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params as { lang: Locale };
const locale = lang;
const isAr = locale === 'ar';
const t = useTranslations(locale);
const a = t.about;

const L = {
  factoryLabel: isAr ? 'صورة المصنع / الورشة' : 'Factory / workshop photo',
  clientsNote: isAr
    ? 'نورّد لشركات رائدة في الصين وحول العالم.'
    : 'Supplying leading enterprises in China and worldwide.',
};

/* ============================================================================
   图片占位：src/assets/images/factory.jpg（厂区/车间图片）
   ============================================================================ */
---

<MainLayout
  locale={locale}
  slug="about"
  title={a.meta.title}
  description={a.meta.description}
  keywords={a.meta.keywords}
  ogImage="/og-about.svg"
>
  <!-- ==================== 页头 ==================== -->
  <section class="relative overflow-hidden bg-brand-700 text-white">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-600 to-brand-900" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-grid opacity-60" aria-hidden="true"></div>

    <div class="container-x relative py-12 lg:py-16">
      <nav class="mb-6 flex items-center gap-2 text-xs font-medium text-brand-200" aria-label="Breadcrumb">
        <a href={getLocalizedPath(locale)} class="hover:text-accent-300">{t.common.breadcrumbHome}</a>
        <svg class="h-3 w-3 flip-rtl" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        <span class="text-white">{t.nav.about}</span>
      </nav>

      <p class="eyebrow !text-accent-400">{a.hero.eyebrow}</p>
      <h1 class="mt-3 max-w-4xl text-2xl font-extrabold leading-tight text-white sm:text-3xl lg:text-[36px]">
        {a.hero.title}
      </h1>
      <p class="mt-5 max-w-3xl text-base leading-relaxed text-brand-100 sm:text-lg">
        {a.hero.subtitle}
      </p>
    </div>
  </section>

  <!-- ==================== 公司简介 ==================== -->
  <section class="bg-white py-16 lg:py-20">
    <div class="container-x grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <SectionHeader title={a.intro.title} />
        <div class="mt-6 space-y-5">
          {a.intro.paragraphs.map((para, i) => (
            <p class:list={['text-[15px] leading-[1.9] text-slate-600', i === 0 && 'text-base font-medium text-slate-700']}>
              {para}
            </p>
          ))}
        </div>
      </div>

      <!-- 侧面：图片占位 + 数据 -->
      <div class="lg:col-span-5">
        <figure class="overflow-hidden rounded-2xl border border-slate-200 shadow-card">
          <!-- 真实图片：src/assets/images/factory.jpg -->
          <div class="aspect-[4/3] w-full">
            <div class="img-placeholder">
              <div class="flex flex-col items-center gap-3 text-center">
                <svg class="h-12 w-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M2 20h20M4 20V8l8-5 8 5v12M9 20v-6h6v6"/>
                </svg>
                <span class="text-[10px] font-bold uppercase tracking-widest text-brand-300">
                  {L.factoryLabel}
                </span>
                <span dir="ltr" class="text-[10px] font-medium text-brand-300/80">
                  src/assets/images/factory.jpg
                </span>
              </div>
            </div>
          </div>
          <figcaption class="sr-only">{a.hero.imageAlt}</figcaption>
        </figure>

        <dl class="mt-6 grid grid-cols-2 gap-4">
          {a.stats.map((s) => (
            <div class="rounded-xl border border-slate-200 bg-slate-50 p-5">
              <dt class="text-2xl font-extrabold tracking-tight text-brand-700">{s.value}</dt>
              <dd class="mt-1.5 text-xs font-medium leading-snug text-slate-600">{s.label}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- ==================== 优势 ==================== -->
  <section class="border-y border-slate-100 bg-slate-50 py-16 lg:py-20">
    <div class="container-x">
      <SectionHeader title={a.advantages.title} align="center" />

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {a.advantages.items.map((item) => (
          <div class="card h-full p-6">
            <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-600 text-white">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
            </span>
            <h3 class="mt-4 text-base font-bold text-brand-700">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{item.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== 生产能力 ==================== -->
  <section class="relative overflow-hidden bg-brand-800 py-16 text-white lg:py-20">
    <div class="absolute inset-0 bg-grid opacity-50" aria-hidden="true"></div>
    <div class="container-x relative">
      <SectionHeader title={a.equipment.title} subtitle={a.equipment.subtitle} align="center" onDark />

      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {a.equipment.items.map((e, i) => (
          <div class="rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm transition-colors hover:border-accent-400/50 hover:bg-white/10">
            <span class="text-xs font-bold tabular-nums text-accent-400">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3 class="mt-2.5 text-base font-bold text-white">{e.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-brand-200">{e.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== 资质认证 ==================== -->
  <section class="border-y border-slate-100 bg-slate-50 py-16 lg:py-20">
    <div class="container-x">
      <SectionHeader title={a.certifications.title} subtitle={a.certifications.subtitle} align="center" />

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {a.certifications.items.map((cert) => (
          <div class="card h-full p-6 text-center">
            <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-accent-50 text-accent-600">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/>
                <path d="m9 12 2 2 4-4"/>
              </svg>
            </span>
            <h3 class="mt-4 text-base font-bold text-brand-700">{cert.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{cert.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== 服务行业 ==================== -->
  <section class="bg-white py-16 lg:py-20">
    <div class="container-x">
      <SectionHeader title={a.industries.title} subtitle={a.industries.subtitle} align="center" />

      <div class="mt-12 grid gap-px overflow-hidden rounded-xl border border-slate-200 bg-slate-200 sm:grid-cols-2 lg:grid-cols-3">
        {a.industries.items.map((ind) => (
          <div class="group bg-white p-6 transition-colors hover:bg-brand-50">
            <div class="flex items-center gap-3">
              <span class="h-8 w-1 rounded-full bg-accent-500 transition-all group-hover:h-10"></span>
              <h3 class="text-base font-bold text-brand-700">{ind.title}</h3>
            </div>
            <p class="mt-3 ps-4 text-sm leading-relaxed text-slate-600">{ind.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== 质量方针 ==================== -->
  <section class="border-t border-slate-100 bg-slate-50 py-16 lg:py-20">
    <div class="container-x grid gap-12 lg:grid-cols-2 lg:gap-16">
      <div>
        <SectionHeader eyebrow={a.hero.eyebrow} title={a.quality.title} />
        <div class="mt-6 space-y-4">
          {a.quality.paragraphs.map((para) => (
            <p class="text-[15px] leading-[1.9] text-slate-600">{para}</p>
          ))}
        </div>
      </div>

      <div class="rounded-2xl border border-brand-100 bg-brand-50 p-7 sm:p-9">
        <ul class="space-y-5">
          {a.quality.points.map((pt) => (
            <li class="flex gap-3.5">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-accent-500 text-white">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              </span>
              <span dir="auto" class="pt-0.5 text-[15px] font-medium leading-relaxed text-brand-800">{pt}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ==================== 合作客户 ==================== -->
  <section class="bg-white py-16 lg:py-20">
    <div class="container-x">
      <SectionHeader title={a.clients.title} subtitle={a.clients.subtitle} align="center" />

      <div class="mt-10 flex flex-wrap items-center justify-center gap-3 sm:gap-4">
        {a.clients.items.map((client) => (
          <span dir="ltr" class="rounded-lg border border-slate-200 bg-slate-50 px-6 py-3.5 text-sm font-bold tracking-wide text-brand-700 sm:text-base">
            {client}
          </span>
        ))}
      </div>

      <p class="mt-6 text-center text-xs font-medium text-slate-500">{L.clientsNote}</p>
    </div>
  </section>

  <!-- ==================== 服务市场 ==================== -->
  <section class="border-t border-slate-100 bg-slate-50 py-16 lg:py-20">
    <div class="container-x">
      <SectionHeader title={a.markets.title} subtitle={a.markets.subtitle} align="center" />

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {a.markets.items.map((m) => (
          <div class="card-hover p-6">
            <span class="flex h-10 w-10 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20"/></svg>
            </span>
            <h3 class="mt-4 text-base font-bold text-brand-700">{m.region}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{m.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== CTA ==================== -->
  <CtaBand
    locale={locale}
    title={a.cta.title}
    subtitle={a.cta.subtitle}
    primary={a.cta.primary}
    secondary={t.common.whatsapp}
    tertiary={t.common.email}
    primaryAction="contact"
    secondaryAction="whatsapp"
    tertiaryAction="email"
  />
</MainLayout>
