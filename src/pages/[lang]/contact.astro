---
/**
 * 联系我们 /{lang}/contact/
 * -----------------------------------------------------------------------------
 * 模块：页头 → 联系方式卡片 → 询盘表单（仅 UI，不提交后端）
 *       → 表单使用说明 → FAQ → CTA
 *
 * ⚠ 表单说明：
 *   本表单无任何后端提交逻辑（无 action、无 fetch、按钮 type="button"）。
 *   填写后由用户自行复制内容，通过 WhatsApp / 邮件发送给业务员。
 *   这样做的好处：静态站无需服务器、无需邮件服务、无垃圾询盘注入风险。
 *
 * 中东站差异：沟通渠道为 WhatsApp + 邮件（去掉 Telegram）。
 */
import MainLayout from '@/layouts/MainLayout.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import CtaBand from '@/components/CtaBand.astro';
import { useTranslations, type Locale, getLocalizedPath } from '@/i18n';
import { CONTACT, whatsappLink, mailtoLink, telLink, CONTACT_CONFIGURED } from '@/config';

export function getStaticPaths() {
  return [{ params: { lang: 'ar' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params as { lang: Locale };
const locale = lang;
const isAr = locale === 'ar';
const t = useTranslations(locale);
const c = t.contact;

/** 预填的 WhatsApp / 邮件正文（按语言） */
const presetText = isAr
  ? 'مرحبًا! أرغب في الحصول على عرض سعر لأكياس FIBC (أكياس السوائب).\nنوع الكيس: \nالمقاس (الطول×العرض×الارتفاع): \nسعة التحميل: \nالكمية: \nنوع المادة: '
  : 'Hello! I would like to receive a quotation for FIBC bulk bags.\nBag type: \nSize (L×W×H): \nLoad capacity: \nQuantity: \nProduct: ';

const emailSubject = isAr ? 'طلب عرض سعر لأكياس FIBC' : 'FIBC bulk bag quotation request';

const waHref = whatsappLink(presetText);
const mailHref = mailtoLink(emailSubject, presetText);

const address = isAr ? CONTACT.addressAr : CONTACT.address;
const hours = isAr ? CONTACT.hoursAr : CONTACT.hours;

/** 联系方式条目（用于卡片渲染） */
const contactItems = [
  {
    key: 'company',
    label: c.info.companyLabel,
    value: t.meta.siteName,
    href: null,
    configured: true,
    icon: 'building',
    mono: false,
  },
  {
    key: 'site',
    label: c.info.siteLabel,
    value: c.info.siteValue,
    href: `https://${c.info.siteValue}`,
    configured: true,
    icon: 'globe',
    mono: true,
  },
  {
    key: 'whatsapp',
    label: c.info.whatsappLabel,
    value: CONTACT_CONFIGURED.whatsapp ? CONTACT.whatsappDisplay : c.info.whatsappValue,
    href: CONTACT_CONFIGURED.whatsapp ? waHref : null,
    configured: CONTACT_CONFIGURED.whatsapp,
    icon: 'whatsapp',
    mono: true,
  },
  {
    key: 'phone',
    label: c.info.phoneLabel,
    value: CONTACT_CONFIGURED.phone ? CONTACT.whatsappDisplay : c.info.phoneValue,
    href: CONTACT_CONFIGURED.phone ? telLink() : null,
    configured: CONTACT_CONFIGURED.phone,
    icon: 'phone',
    mono: true,
  },
  {
    key: 'email',
    label: c.info.emailLabel,
    value: CONTACT_CONFIGURED.email ? CONTACT.email : c.info.emailValue,
    href: CONTACT_CONFIGURED.email ? mailHref : null,
    configured: CONTACT_CONFIGURED.email,
    icon: 'mail',
    mono: true,
  },
  {
    key: 'address',
    label: c.info.addressLabel,
    value: address,
    href: null,
    configured: true,
    icon: 'pin',
    mono: false,
  },
  {
    key: 'hours',
    label: c.info.hoursLabel,
    value: hours,
    href: null,
    configured: true,
    icon: 'clock',
    mono: false,
  },
];
---

<MainLayout
  locale={locale}
  slug="contact"
  title={c.meta.title}
  description={c.meta.description}
  keywords={c.meta.keywords}
  ogImage="/og-contact.svg"
>
  <!-- ==================== 页头 ==================== -->
  <section class="relative overflow-hidden bg-brand-700 text-white">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-600 to-brand-900" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-grid opacity-60" aria-hidden="true"></div>

    <div class="container-x relative py-12 lg:py-16">
      <nav class="mb-6 flex items-center gap-2 text-xs font-medium text-brand-200" aria-label="Breadcrumb">
        <a href={getLocalizedPath(locale)} class="hover:text-accent-300">{t.common.breadcrumbHome}</a>
        <svg class="h-3 w-3 flip-rtl" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        <span class="text-white">{t.nav.contact}</span>
      </nav>

      <p class="eyebrow !text-accent-400">{c.hero.eyebrow}</p>
      <h1 class="mt-3 text-3xl font-extrabold leading-tight text-white sm:text-4xl">{c.hero.title}</h1>
      <p class="mt-5 max-w-3xl text-base leading-relaxed text-brand-100 sm:text-lg">{c.hero.subtitle}</p>

      <!-- 快捷联系按钮 -->
      <div class="mt-9 flex flex-wrap items-center gap-3">
        <a href={waHref} target="_blank" rel="noopener noreferrer" class="btn-whatsapp !px-6 !py-3.5 text-base">
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47 0 1.46 1.06 2.87 1.21 3.07.15.2 2.09 3.2 5.07 4.48.71.31 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35zM12.05 21.5h-.01a9.4 9.4 0 0 1-4.79-1.31l-.34-.2-3.56.93.95-3.47-.22-.36a9.38 9.38 0 0 1-1.44-5.02c0-5.19 4.23-9.41 9.42-9.41 2.52 0 4.88.98 6.66 2.76a9.35 9.35 0 0 1 2.76 6.66c0 5.19-4.23 9.42-9.43 9.42zM20.5 3.49A11.8 11.8 0 0 0 12.05 0C5.5 0 .17 5.33.17 11.88c0 2.09.55 4.14 1.59 5.94L0 24l6.34-1.66a11.85 11.85 0 0 0 5.7 1.45h.01c6.55 0 11.88-5.33 11.88-11.88 0-3.17-1.24-6.16-3.48-8.42z"/></svg>
          WhatsApp
        </a>
        <a href={mailHref} class="btn-ghost-light !px-6 !py-3.5 text-base">
          {c.cta.secondary}
        </a>
        <a href={telLink()} class="btn-ghost-light !px-6 !py-3.5 text-base">
          <span dir="ltr">{CONTACT.whatsappDisplay}</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ==================== 联系方式 + 表单 ==================== -->
  <section class="bg-white py-16 lg:py-20">
    <div class="container-x grid gap-12 lg:grid-cols-12 lg:gap-14">
      <!-- 联系方式 -->
      <div class="lg:col-span-5">
        <SectionHeader title={c.info.title} subtitle={c.info.subtitle} />

        <dl class="mt-8 space-y-5">
          {contactItems.map((item) => (
            <div class="flex gap-4 border-b border-slate-100 pb-5 last:border-0">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
                {item.icon === 'building' && (
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21h18M5 21V7l8-4 8 4v14M9 9h.01M9 13h.01M9 17h.01M15 9h.01M15 13h.01M15 17h.01"/></svg>
                )}
                {item.icon === 'globe' && (
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20"/></svg>
                )}
                {item.icon === 'whatsapp' && (
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47 0 1.46 1.06 2.87 1.21 3.07.15.2 2.09 3.2 5.07 4.48.71.31 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35zM12.05 21.5h-.01a9.4 9.4 0 0 1-4.79-1.31l-.34-.2-3.56.93.95-3.47-.22-.36a9.38 9.38 0 0 1-1.44-5.02c0-5.19 4.23-9.41 9.42-9.41 2.52 0 4.88.98 6.66 2.76a9.35 9.35 0 0 1 2.76 6.66c0 5.19-4.23 9.42-9.43 9.42zM20.5 3.49A11.8 11.8 0 0 0 12.05 0C5.5 0 .17 5.33.17 11.88c0 2.09.55 4.14 1.59 5.94L0 24l6.34-1.66a11.85 11.85 0 0 0 5.7 1.45h.01c6.55 0 11.88-5.33 11.88-11.88 0-3.17-1.24-6.16-3.48-8.42z"/></svg>
                )}
                {item.icon === 'phone' && (
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2Z"/></svg>
                )}
                {item.icon === 'mail' && (
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg>
                )}
                {item.icon === 'pin' && (
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0Z"/><circle cx="12" cy="10" r="3"/></svg>
                )}
                {item.icon === 'clock' && (
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
                )}
              </span>

              <div class="min-w-0 flex-1">
                <dt class="text-xs font-bold uppercase tracking-wide text-slate-500">{item.label}</dt>
                <dd class:list={['mt-1 text-sm font-medium leading-relaxed', item.configured ? 'text-brand-800' : 'italic text-accent-700', item.mono && 'font-mono break-all']} dir="auto">
                  {item.href ? (
                    <a href={item.href} target={item.href.startsWith('http') ? '_blank' : undefined} rel="noopener noreferrer" class="transition-colors hover:text-accent-600 hover:underline">
                      {item.value}
                    </a>
                  ) : (
                    item.value
                  )}
                </dd>
                {!item.configured && (
                  <p class="mt-1 text-[11px] font-medium text-accent-600">{t.common.placeholderNote}</p>
                )}
              </div>
            </div>
          ))}
        </dl>
      </div>

      <!-- 询盘表单（仅 UI） -->
      <div class="lg:col-span-7">
        <div class="overflow-hidden rounded-2xl border border-slate-200 shadow-card">
          <div class="border-b border-slate-100 bg-slate-50 px-6 py-5 sm:px-8">
            <h2 class="text-lg font-bold text-brand-700">{c.form.title}</h2>
            <p class="mt-1.5 text-sm leading-relaxed text-slate-600">{c.form.subtitle}</p>
          </div>

          <!-- ⚠ 仅 UI 表单：无 action / 无 method / 无 fetch 提交 -->
          <form
            id="inquiry-form"
            class="space-y-5 px-6 py-7 sm:px-8"
            novalidate
            data-no-backend="true"
            data-whatsapp-number={CONTACT.whatsappNumber}
            data-email-address={CONTACT.email}
            data-email-subject={emailSubject}
            data-labels={JSON.stringify({
              name: c.form.fields.name,
              company: c.form.fields.company,
              country: c.form.fields.country,
              email: c.form.fields.email,
              whatsapp: c.form.fields.whatsapp,
              product: c.form.fields.product,
              quantity: c.form.fields.quantity,
              message: c.form.fields.message,
            })}
          >
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label class="field-label" for="f-name">{c.form.fields.name}</label>
                <input class="field-input" id="f-name" name="name" type="text" placeholder={c.form.fields.namePlaceholder} autocomplete="name" />
              </div>
              <div>
                <label class="field-label" for="f-company">{c.form.fields.company}</label>
                <input class="field-input" id="f-company" name="company" type="text" placeholder={c.form.fields.companyPlaceholder} autocomplete="organization" />
              </div>
              <div>
                <label class="field-label" for="f-country">{c.form.fields.country}</label>
                <input class="field-input" id="f-country" name="country" type="text" placeholder={c.form.fields.countryPlaceholder} autocomplete="country-name" />
              </div>
              <div>
                <label class="field-label" for="f-email">{c.form.fields.email}</label>
                <input class="field-input" id="f-email" name="email" type="email" placeholder={c.form.fields.emailPlaceholder} autocomplete="email" />
              </div>
              <div>
                <label class="field-label" for="f-whatsapp">{c.form.fields.whatsapp}</label>
                <input class="field-input" id="f-whatsapp" name="whatsapp" type="tel" placeholder={c.form.fields.whatsappPlaceholder} autocomplete="tel" />
              </div>
              <div>
                <label class="field-label" for="f-quantity">{c.form.fields.quantity}</label>
                <input class="field-input" id="f-quantity" name="quantity" type="text" placeholder={c.form.fields.quantityPlaceholder} />
              </div>
            </div>

            <div>
              <label class="field-label" for="f-product">{c.form.fields.product}</label>
              <select class="field-input" id="f-product" name="product">
                {c.form.fields.productOptions.map((opt) => <option value={opt}>{opt}</option>)}
              </select>
            </div>

            <div>
              <label class="field-label" for="f-message">{c.form.fields.message}</label>
              <textarea class="field-input min-h-[130px] resize-y" id="f-message" name="message" rows={5} placeholder={c.form.fields.messagePlaceholder}></textarea>
            </div>

            <!-- 提示：本表单不提交数据 -->
            <div class="rounded-lg border border-accent-200 bg-accent-50 p-4">
              <p class="flex gap-2.5 text-xs leading-relaxed text-accent-800">
                <svg class="mt-0.5 h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 8v4M12 16h.01"/></svg>
                <span>
                  <span class="font-bold">{c.form.noticeTitle}:</span>
                  {' '}{c.form.noticeText}
                </span>
              </p>
            </div>

            <!-- 操作按钮组（全部 type=button，无提交行为） -->
            <div class="flex flex-col gap-3 sm:flex-row">
              <button type="button" id="btn-whatsapp" class="btn-whatsapp flex-1">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47 0 1.46 1.06 2.87 1.21 3.07.15.2 2.09 3.2 5.07 4.48.71.31 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35zM12.05 21.5h-.01a9.4 9.4 0 0 1-4.79-1.31l-.34-.2-3.56.93.95-3.47-.22-.36a9.38 9.38 0 0 1-1.44-5.02c0-5.19 4.23-9.41 9.42-9.41 2.52 0 4.88.98 6.66 2.76a9.35 9.35 0 0 1 2.76 6.66c0 5.19-4.23 9.42-9.43 9.42zM20.5 3.49A11.8 11.8 0 0 0 12.05 0C5.5 0 .17 5.33.17 11.88c0 2.09.55 4.14 1.59 5.94L0 24l6.34-1.66a11.85 11.85 0 0 0 5.7 1.45h.01c6.55 0 11.88-5.33 11.88-11.88 0-3.17-1.24-6.16-3.48-8.42z"/></svg>
                {c.form.sendWhatsapp}
              </button>
              <button type="button" id="btn-email" class="btn-brand flex-1">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg>
                {c.form.sendEmail}
              </button>
              <button type="button" id="btn-copy" class="btn-outline" data-copied-label={c.form.copied}>
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                <span id="btn-copy-label">{c.form.copyButton}</span>
              </button>
            </div>

            <p class="text-center text-[11px] font-medium text-slate-400">
              {c.form.submitHint}
            </p>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== FAQ ==================== -->
  <section class="border-y border-slate-100 bg-slate-50 py-16 lg:py-20">
    <div class="container-x">
      <SectionHeader title={c.faq.title} align="center" />

      <div class="mx-auto mt-12 max-w-3xl space-y-3">
        {c.faq.items.map((item) => (
          <details class="group card overflow-hidden [&_summary::-webkit-details-marker]:hidden">
            <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-5">
              <h3 class="text-[15px] font-bold text-brand-700">{item.q}</h3>
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-600 transition-transform duration-200 group-open:rotate-45">
                <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
              </span>
            </summary>
            <div class="border-t border-slate-100 px-6 py-5">
              <p class="text-sm leading-relaxed text-slate-600">{item.a}</p>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== CTA ==================== -->
  <CtaBand
    locale={locale}
    title={c.cta.title}
    subtitle={c.cta.subtitle}
    primary={c.cta.primary}
    secondary={c.cta.secondary}
    primaryAction="whatsapp"
    secondaryAction="email"
    tertiaryAction="none"
  />
</MainLayout>

<!-- ============================================================================
     表单辅助脚本：把填写内容拼成文本 → 打开 WhatsApp / 邮件 / 复制
     注意：全程无网络提交，数据仅留在用户浏览器中
     ============================================================================ -->
<script>
  (function () {
    const form = document.getElementById('inquiry-form') as HTMLFormElement | null;
    if (!form) return;

    const whatsappNumber = form.dataset.whatsappNumber || '';
    const emailAddress = form.dataset.emailAddress || '';

    const val = (id: string) => {
      const el = document.getElementById(id) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
      return el?.value?.trim() ?? '';
    };

    /** 收集表单内容为纯文本 */
    const collect = (): string => {
      const labels = JSON.parse(form.dataset.labels || '{}');
      const rows: Array<[string, string]> = [
        [labels.name || 'Name', val('f-name')],
        [labels.company || 'Company', val('f-company')],
        [labels.country || 'Country', val('f-country')],
        [labels.email || 'Email', val('f-email')],
        [labels.whatsapp || 'WhatsApp', val('f-whatsapp')],
        [labels.product || 'Product', val('f-product')],
        [labels.quantity || 'Quantity', val('f-quantity')],
        [labels.message || 'Requirement', val('f-message')],
      ];
      return rows
        .filter(([, v]) => v)
        .map(([k, v]) => `${k}: ${v}`)
        .join('\n');
    };

    const openWhatsapp = () => {
      const text = collect();
      const base = whatsappNumber ? `https://wa.me/${whatsappNumber}` : 'https://wa.me/';
      window.open(text ? `${base}?text=${encodeURIComponent(text)}` : base, '_blank', 'noopener');
    };

    const openEmail = () => {
      const text = collect();
      const subject = encodeURIComponent(form.dataset.emailSubject || 'FIBC inquiry');
      const body = encodeURIComponent(text);
      window.location.href = `mailto:${emailAddress}?subject=${subject}&body=${body}`;
    };

    const copyText = async () => {
      const btn = document.getElementById('btn-copy');
      const label = document.getElementById('btn-copy-label');
      const text = collect();
      if (!text || !label || !btn) return;
      try {
        await navigator.clipboard.writeText(text);
      } catch {
        // 降级：使用临时 textarea
        const ta = document.createElement('textarea');
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
      }
      const original = label.textContent || '';
      label.textContent = btn.dataset.copiedLabel || 'Copied';
      setTimeout(() => { label.textContent = original; }, 1800);
    };

    document.getElementById('btn-whatsapp')?.addEventListener('click', openWhatsapp);
    document.getElementById('btn-email')?.addEventListener('click', openEmail);
    document.getElementById('btn-copy')?.addEventListener('click', copyText);

    // 阻止任何隐式提交（回车键）
    form.addEventListener('submit', (e) => e.preventDefault());
  })();
</script>
