---
/**
 * 产品页 /{lang}/products/
 * -----------------------------------------------------------------------------
 * 模块：页头（面包屑 + 标准参数横条）→ 产品列表（8 类）→ 详细说明 → 详细规格表 → CTA
 */
import MainLayout from '@/layouts/MainLayout.astro';
import ProductCard from '@/components/ProductCard.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import CtaBand from '@/components/CtaBand.astro';
import { useTranslations, type Locale, getLocalizedPath } from '@/i18n';
import { getEntry } from 'astro:content';

export function getStaticPaths() {
  return [{ params: { lang: 'ar' } }, { params: { lang: 'en' } }];
}

const { lang } = Astro.params as { lang: Locale };
const locale = lang;
const isAr = locale === 'ar';
const t = useTranslations(locale);
const p = t.products;

/** 产品数据（content collection：src/content/products/{lang}.json） */
const productsData = (await getEntry('products', locale))?.data;

const L = {
  features: isAr ? 'أهم المزايا' : 'Key features',
  applications: isAr ? 'الاستخدام' : 'Applications',
  packagingNote: isAr
    ? 'ملاحظة: جميع الأكياس تُعبّأ 100 قطعة على منصة، بتغليف مقاوم للرطوبة وبيانات حسب متطلباتك.'
    : 'Note: all bags are packed 100 pcs per pallet, with moisture-proof wrapping and customer-specific marking.',
};

/* ============================================================================
   页头图片占位：src/assets/images/products-hero.jpg
   替换方式见 Hero.astro / ProductCard.astro 中的注释说明
   ============================================================================ */
---

<MainLayout
  locale={locale}
  slug="products"
  title={p.meta.title}
  description={p.meta.description}
  keywords={p.meta.keywords}
  ogImage="/og-products.svg"
>
  <!-- ==================== 页头 ==================== -->
  <section class="relative overflow-hidden bg-brand-700 text-white">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-600 to-brand-900" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-grid opacity-60" aria-hidden="true"></div>

    <div class="container-x relative py-12 lg:py-16">
      <!-- 面包屑 -->
      <nav class="mb-6 flex items-center gap-2 text-xs font-medium text-brand-200" aria-label="Breadcrumb">
        <a href={getLocalizedPath(locale)} class="hover:text-accent-300">{t.common.breadcrumbHome}</a>
        <svg class="h-3 w-3 flip-rtl" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        <span class="text-white">{t.nav.products}</span>
      </nav>

      <p class="eyebrow !text-accent-400">{p.hero.eyebrow}</p>
      <h1 class="mt-3 max-w-3xl text-3xl font-extrabold leading-tight text-white sm:text-4xl lg:text-[40px]">
        {p.hero.title}
      </h1>
      <p class="mt-5 max-w-3xl text-base leading-relaxed text-brand-100 sm:text-lg">
        {p.hero.subtitle}
      </p>

      <!-- 标准参数横条 -->
      <dl class="mt-10 grid gap-px overflow-hidden rounded-xl border border-white/15 bg-white/10 backdrop-blur-sm sm:grid-cols-2 lg:grid-cols-4">
        {productsData.specs.map((s) => (
          <div class="bg-brand-700/60 px-5 py-4">
            <dt class="text-[11px] font-bold uppercase tracking-wide text-brand-300">{s.key}</dt>
            <dd dir="auto" class="mt-1.5 text-sm font-semibold text-white">{s.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- ==================== 产品列表 ==================== -->
  <section class="bg-white py-16 lg:py-20">
    <div class="container-x">
      <SectionHeader eyebrow={p.hero.eyebrow} title={p.list.title} subtitle={p.list.subtitle} />

      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {productsData.items.map((item) => (
          <ProductCard
            locale={locale}
            id={item.id}
            name={item.name}
            short={item.short}
            applications={item.applications}
            specs={item.specs}
            imageAlt={item.imageAlt}
            customizableLabel={p.list.customizableLabel}
            learnMoreLabel={t.common.learnMore}
            specsLabel={p.card.specsLabel}
            applicationsLabel={p.card.applicationsLabel}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ==================== 详细说明（每种产品一段） ==================== -->
  <section class="border-y border-slate-100 bg-slate-50 py-16 lg:py-20">
    <div class="container-x">
      <SectionHeader
        eyebrow={p.list.customizableLabel}
        title={p.list.detailTitle}
      />

      <div class="mt-12 space-y-6">
        {productsData.items.map((item, i) => (
          <article id={`detail-${item.id}`} class="card overflow-hidden">
            <div class="grid gap-0 lg:grid-cols-12">
              <!-- 分类视觉位（技术感占位，接入真实图片见 src/assets/images/README.md） -->
              <div class:list={['relative overflow-hidden lg:col-span-4', i % 2 === 1 && 'lg:order-2']}>
                <div class="relative h-full min-h-[220px] w-full">
                  <div class="absolute inset-0 bg-gradient-to-br from-brand-600 to-brand-800"></div>
                  <div class="absolute inset-0 bg-grid opacity-50"></div>
                  <div class="absolute -end-8 -top-8 h-28 w-28 rounded-full bg-accent-500/20 blur-2xl"></div>

                  <div class="relative flex h-full flex-col items-center justify-center gap-3 px-6 py-8 text-center">
                    <span class="text-[11px] font-bold tabular-nums tracking-[0.2em] text-accent-400">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <svg class="h-14 w-14 text-white/85" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M8 3h8l1 4v12a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V7l1-4Z" />
                      <path d="M7.2 7h9.6" />
                      <path d="M10.5 11h3" />
                    </svg>
                    <span dir="ltr" class="max-w-[180px] text-[10px] font-semibold uppercase leading-relaxed tracking-widest text-brand-300">
                      {item.id}.jpg
                    </span>
                  </div>
                </div>
              </div>

              <!-- 文字 -->
              <div class:list={['p-6 sm:p-8 lg:col-span-8', i % 2 === 1 && 'lg:order-1']}>
                <h3 class="text-lg font-bold text-brand-700 sm:text-xl">{item.name}</h3>
                <p class="mt-3 text-sm leading-relaxed text-slate-600 sm:text-[15px]">
                  {item.description}
                </p>

                <!-- 真实规格 -->
                {item.specs && item.specs.length > 0 && (
                  <dl class="mt-5 grid gap-x-6 gap-y-3 rounded-lg border border-slate-100 bg-slate-50 px-5 py-4 sm:grid-cols-3">
                    {item.specs.map((s) => (
                      <div>
                        <dt class="text-[11px] font-bold uppercase tracking-wide text-slate-500">{s.key}</dt>
                        <dd dir="auto" class="mt-1 text-sm font-medium leading-snug text-brand-800">{s.value}</dd>
                      </div>
                    ))}
                  </dl>
                )}

                <div class="mt-6 grid gap-6 sm:grid-cols-2">
                  <div>
                    <h4 class="text-xs font-bold uppercase tracking-wide text-accent-600">
                      {L.features}
                    </h4>
                    <ul class="mt-3 space-y-2">
                      {item.features.map((f) => (
                        <li class="flex gap-2 text-sm text-slate-600">
                          <svg class="mt-0.5 h-4 w-4 shrink-0 text-brand-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                          <span>{f}</span>
                        </li>
                      ))}
                    </ul>
                  </div>

                  <div>
                    <h4 class="text-xs font-bold uppercase tracking-wide text-accent-600">
                      {L.applications}
                    </h4>
                    <p dir="auto" class="mt-3 text-sm leading-relaxed text-slate-600">{item.applications}</p>

                    <a href={getLocalizedPath(locale, 'contact')} class="mt-5 inline-flex items-center gap-1.5 text-sm font-bold text-brand-600 transition-colors hover:text-accent-600">
                      {t.common.getQuote}
                      <svg class="h-4 w-4 flip-rtl nudge-x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                    </a>
                  </div>
                </div>
              </div>
            </div>
          </article>
        ))}
      </div>

      <p dir="auto" class="mt-8 text-center text-xs font-medium text-slate-500">
        {L.packagingNote}
      </p>
    </div>
  </section>

  <!-- ==================== 详细规格表 ==================== -->
  <section class="bg-white py-16 lg:py-20">
    <div class="container-x">
      <SectionHeader title={p.specTable.title} align="center" />

      <div class="mx-auto mt-10 max-w-4xl overflow-hidden rounded-xl border border-slate-200">
        <table class="w-full border-collapse text-start text-sm">
          <caption class="sr-only">{p.specTable.title}</caption>
          <thead class="bg-brand-700 text-white">
            <tr>
              <th scope="col" class="px-5 py-4 text-start font-semibold">
                {p.specTable.paramLabel}
              </th>
              <th scope="col" class="px-5 py-4 text-start font-semibold">
                {p.specTable.valueLabel}
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 bg-white">
            {productsData.specTableRows.map((row, i) => (
              <tr class:list={[i % 2 === 1 && 'bg-slate-50/60']}>
                <th scope="row" class="w-2/5 px-5 py-3.5 align-top text-start font-semibold text-slate-600">
                  {row.key}
                </th>
                <td dir="auto" class="px-5 py-3.5 align-top font-medium text-brand-800">{row.value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ==================== CTA ==================== -->
  <CtaBand
    locale={locale}
    title={p.cta.title}
    subtitle={p.cta.subtitle}
    primary={p.cta.primary}
    secondary={t.common.whatsapp}
    tertiary={t.common.email}
    primaryAction="contact"
    secondaryAction="whatsapp"
    tertiaryAction="email"
  />
</MainLayout>
