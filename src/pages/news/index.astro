---
/**
 * 新闻列表页 /{lang}/news/
 * -----------------------------------------------------------------------------
 * 数据源：src/content/news/{ar,en}/*.md（content collection）
 * 只显示当前语言、非草稿文章，按日期倒序。
 */
import MainLayout from '@/layouts/MainLayout.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import CtaBand from '@/components/CtaBand.astro';
import { getCollection } from 'astro:content';
import { useTranslations, type Locale, getLocalizedPath, INTL_LOCALE } from '@/i18n';

const locale: Locale = 'en'; // 单语站：根路径直出
const t = useTranslations(locale);
const n = t.news;

/** 当前语言的文章（id 形如 "ar/my-post"，草稿不显示，日期倒序） */
const posts = (await getCollection('news', ({ id, data }) => {
  const normalized = id.replace(/\\/g, '/');
  return normalized.startsWith(`${locale}/`) && !data.draft;
})).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

/**
 * 日期格式化：阿拉伯语使用拉丁数字（-u-nu-latn），
 * 与页面其他数字（规格、尺寸）保持一致，便于 B2B 客户阅读。
 */
const fmt = new Intl.DateTimeFormat(INTL_LOCALE[locale], {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<MainLayout
  locale={locale}
  slug="news"
  title={n.meta.title}
  description={n.meta.description}
  keywords={n.meta.keywords}
  ogImage="/og-default.svg"
>
  <!-- ==================== 页头 ==================== -->
  <section class="relative overflow-hidden bg-brand-700 text-white">
    <div class="absolute inset-0 bg-gradient-to-br from-brand-600 to-brand-900" aria-hidden="true"></div>
    <div class="absolute inset-0 bg-grid opacity-60" aria-hidden="true"></div>

    <div class="container-x relative py-12 lg:py-16">
      <nav class="mb-6 flex items-center gap-2 text-xs font-medium text-brand-200" aria-label="Breadcrumb">
        <a href={getLocalizedPath(locale)} class="hover:text-accent-300">{t.common.breadcrumbHome}</a>
        <svg class="h-3 w-3 flip-rtl" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
        <span class="text-white">{t.nav.news}</span>
      </nav>

      <p class="eyebrow !text-accent-400">{n.hero.eyebrow}</p>
      <h1 class="mt-3 max-w-3xl text-3xl font-extrabold leading-tight text-white sm:text-4xl lg:text-[40px]">
        {n.hero.title}
      </h1>
      <p class="mt-5 max-w-3xl text-base leading-relaxed text-brand-100 sm:text-lg">
        {n.hero.subtitle}
      </p>
    </div>
  </section>

  <!-- ==================== 文章列表 ==================== -->
  <section class="bg-white py-16 lg:py-20">
    <div class="container-x">
      <div class="mx-auto max-w-3xl">
        {posts.length === 0 && (
          <p class="rounded-xl border border-dashed border-slate-200 bg-slate-50 px-6 py-12 text-center text-sm text-slate-500">
            {n.list.empty}
          </p>
        )}

        <div class="space-y-6">
          {posts.map((post) => {
            const slug = post.id.replace(/\\/g, '/').split('/')[1];
            return (
              <article class="card p-6 transition-shadow hover:shadow-cardHover sm:p-8">
                <div class="flex flex-wrap items-center gap-3">
                  <time datetime={post.data.date.toISOString()} class="inline-flex items-center rounded-full bg-brand-50 px-3 py-1 text-xs font-bold text-brand-600">
                    <svg class="me-1.5 h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <rect x="3" y="4" width="18" height="18" rx="2" /><path d="M16 2v4M8 2v4M3 10h18" />
                    </svg>
                    {fmt.format(post.data.date)}
                  </time>
                </div>

                <h2 class="mt-4 text-lg font-bold leading-snug text-brand-700 sm:text-xl">
                  <a href={getLocalizedPath(locale, `news/${slug}`)} class="transition-colors hover:text-accent-600">
                    {post.data.title}
                  </a>
                </h2>

                <p class="mt-3 text-sm leading-relaxed text-slate-600 sm:text-[15px]">
                  {post.data.description}
                </p>

                <a
                  href={getLocalizedPath(locale, `news/${slug}`)}
                  class="mt-5 inline-flex items-center gap-1.5 text-sm font-bold text-brand-600 transition-colors hover:text-accent-600"
                >
                  {n.list.readMore}
                  <svg class="h-4 w-4 flip-rtl nudge-x" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                </a>
              </article>
            );
          })}
        </div>
      </div>
    </div>
  </section>

  <!-- ==================== CTA ==================== -->
  <CtaBand
    locale={locale}
    title={t.home.cta.title}
    subtitle={t.home.cta.subtitle}
    primary={t.home.cta.primary}
    secondary={t.common.whatsapp}
    primaryAction="contact"
    secondaryAction="whatsapp"
    tertiaryAction="none"
  />
</MainLayout>
