---
/**
 * FloatingWhatsAppButton —— 右下角浮动 WhatsApp 联系按钮
 * -----------------------------------------------------------------------------
 *  - 固定定位，悬浮于内容之上
 *  - 带呼吸动画，吸引注意
 *  - 点击直接跳转 WhatsApp 私信（中东市场最常用的沟通渠道）
 *
 * RTL 说明：按钮用 end-5 定位（= RTL 下的左下角），避免遮挡阿拉伯语页面的
 * 主要阅读区域，同时符合“操作区跟随阅读方向”的本地化习惯。
 */
import { whatsappLink } from '@/config';
import type { Locale } from '@/i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const waText =
  locale === 'ar'
    ? 'مرحبًا! أرغب في الحصول على عرض سعر لأكياس FIBC (أكياس السوائب).'
    : 'Hello! I am interested in FIBC bulk bags. Please send me your quotation.';
const href = whatsappLink(waText);
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="fixed bottom-5 end-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg transition-all hover:scale-110 hover:bg-[#1eb959] hover:shadow-xl sm:bottom-6 sm:end-6"
  aria-label={locale === 'ar' ? 'تواصل معنا على واتساب' : 'Contact us on WhatsApp'}
>
  <!-- 呼吸动画背景 -->
  <span class="absolute inset-0 rounded-full bg-[#25D366] animate-ping opacity-30" aria-hidden="true"></span>

  <svg class="relative h-7 w-7" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.07-.15-.67-1.62-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.01-1.04 2.47 0 1.46 1.06 2.87 1.21 3.07.15.2 2.09 3.2 5.07 4.48.71.31 1.26.49 1.69.62.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.69.25-1.28.17-1.41-.07-.13-.27-.2-.57-.35zM12.05 21.5h-.01a9.4 9.4 0 0 1-4.79-1.31l-.34-.2-3.56.93.95-3.47-.22-.36a9.38 9.38 0 0 1-1.44-5.02c0-5.19 4.23-9.41 9.42-9.41 2.52 0 4.88.98 6.66 2.76a9.35 9.35 0 0 1 2.76 6.66c0 5.19-4.23 9.42-9.43 9.42zM20.5 3.49A11.8 11.8 0 0 0 12.05 0C5.5 0 .17 5.33.17 11.88c0 2.09.55 4.14 1.59 5.94L0 24l6.34-1.66a11.85 11.85 0 0 0 5.7 1.45h.01c6.55 0 11.88-5.33 11.88-11.88 0-3.17-1.24-6.16-3.48-8.42z"/>
  </svg>
</a>
