---
/**
 * CtaBand —— 通用底部行动条（深蓝背景 + 橙色主按钮）
 * -----------------------------------------------------------------------------
 * 中东站把“聊天渠道”从 Telegram 换成 WhatsApp（当地主流），
 * 并保留邮件作为正式询盘渠道。
 */
import { getLocalizedPath, type Locale } from '@/i18n';
import { whatsappLink, mailtoLink } from '@/config';

type Action = 'contact' | 'whatsapp' | 'email' | 'none';

interface Props {
  locale: Locale;
  title: string;
  subtitle?: string;
  primary?: string;
  secondary?: string;
  tertiary?: string;
  /** 主按钮：跳转联系页（默认）/ WhatsApp / 邮件 */
  primaryAction?: Action;
  secondaryAction?: Action;
  tertiaryAction?: Action;
}

const {
  locale,
  title,
  subtitle,
  primary,
  secondary,
  tertiary,
  primaryAction = 'contact',
  secondaryAction = 'whatsapp',
  tertiaryAction = 'email',
} = Astro.props;

const presetText =
  locale === 'ar'
    ? 'مرحبًا! أرغب في الحصول على عرض سعر لأكياس FIBC (أكياس السوائب).'
    : 'Hello! I would like to receive a quotation for FIBC bulk bags.';

const hrefFor = (action: Action) =>
  action === 'whatsapp' ? whatsappLink(presetText)
  : action === 'email' ? mailtoLink(
      locale === 'ar' ? 'طلب عرض سعر لأكياس FIBC' : 'FIBC bulk bag quotation request',
      presetText,
    )
  : getLocalizedPath(locale, 'contact');

const isExternal = (action: Action) => action === 'whatsapp';
---

<section class="bg-brand-600">
  <div class="container-x py-12 lg:py-16">
    <div class="relative overflow-hidden rounded-2xl border border-white/10 bg-brand-700 px-6 py-10 sm:px-10 lg:px-14 lg:py-12">
      <div class="absolute inset-0 bg-grid opacity-50" aria-hidden="true"></div>
      <div class="absolute -end-16 -top-16 h-64 w-64 rounded-full bg-accent-500/20 blur-3xl" aria-hidden="true"></div>

      <div class="relative flex flex-col items-start gap-7 lg:flex-row lg:items-center lg:justify-between">
        <div class="max-w-2xl">
          <h2 class="text-2xl font-bold leading-tight text-white sm:text-3xl">{title}</h2>
          {subtitle && (
            <p class="mt-3 text-sm leading-relaxed text-brand-200 sm:text-base">{subtitle}</p>
          )}
        </div>

        <div class="flex shrink-0 flex-wrap items-center gap-3">
          {primary && primaryAction !== 'none' && (
            <a
              href={hrefFor(primaryAction)}
              {...(isExternal(primaryAction) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              class="btn-accent !px-6 !py-3.5 text-base"
            >
              {primary}
            </a>
          )}
          {secondary && secondaryAction !== 'none' && (
            <a
              href={hrefFor(secondaryAction)}
              {...(isExternal(secondaryAction) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              class="btn-ghost-light !px-6 !py-3.5 text-base"
            >
              {secondary}
            </a>
          )}
          {tertiary && tertiaryAction !== 'none' && (
            <a
              href={hrefFor(tertiaryAction)}
              {...(isExternal(tertiaryAction) ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              class="btn-ghost-light !px-6 !py-3.5 text-base"
            >
              {tertiary}
            </a>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
